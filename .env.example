# MySQL
MYSQL_HOST=your-cloud-host
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your-password

# Redis
REDIS_HOST=your-cloud-host
REDIS_PORT=6379
REDIS_PASSWORD=your-password

# Nacos
NACOS_HOST=your-cloud-host
NACOS_PORT=8848

# RocketMQ
ROCKETMQ_NAMESRV_ADDR=your-cloud-host:9876

# Elasticsearch
ES_HOST=your-cloud-host
ES_PORT=9200

# MinIO
MINIO_ENDPOINT=http://your-cloud-host:9000
# 对外可访问的 MinIO endpoint（客户端可达，如域名或公网IP）；为空时预签名 URL 复用 MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=http://your-public-host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-password

# Seata
SEATA_HOST=your-cloud-host
SEATA_PORT=8091

# Sentinel
SENTINEL_DASHBOARD=your-cloud-host:8080

# XXL-JOB
XXL_JOB_ADMIN_ADDRESSES=http://your-cloud-host:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=your-token

# SkyWalking
SW_AGENT_COLLECTOR_BACKEND_SERVICES=your-cloud-host:11800

# Alipay（沙箱网关为默认，prod 需改为 https://openapi.alipay.com/gateway.do）
ALIPAY_APP_ID=your-app-id
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_PRIVATE_KEY=your-private-key
ALIPAY_PUBLIC_KEY=your-public-key
ALIPAY_NOTIFY_URL=http://your-domain/api/v1/pay/callback/alipay
ALIPAY_RETURN_URL=http://your-domain/pay/success

# JWT 签名密钥（≥32 字节随机串，auth 与 gateway 必须一致）
MINIMALL_JWT_SECRET=<your-32+bytes-random-secret>
# 网关内部接口共享令牌
MINIMALL_INTERNAL_TOKEN=<your-random-token>
# AES-256 字段加密密钥（Base64 编码的 32 字节随机值）
MINIMALL_SECURITY_AES_KEY=<your-base64-32-bytes-key>