# MySQL
MYSQL_HOST=your-cloud-host
MYSQL_PORT=3306
MYSQL_USER=minimall
MYSQL_PASSWORD=your-password

# Redis
REDIS_HOST=your-cloud-host
REDIS_PORT=6379
REDIS_PASSWORD=your-password

# Nacos
NACOS_HOST=your-cloud-host
NACOS_PORT=8848

# RocketMQ
ROCKETMQ_NAMESRV_ADDR=your-cloud-host:9876

# Elasticsearch
ES_HOST=your-cloud-host
ES_PORT=9200

# MinIO
MINIO_ENDPOINT=http://your-cloud-host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-password

# Seata
SEATA_HOST=your-cloud-host
SEATA_PORT=8091

# Sentinel
SENTINEL_DASHBOARD=your-cloud-host:8080

# XXL-JOB
XXL_JOB_ADMIN_ADDRESSES=http://your-cloud-host:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=your-token

# SkyWalking
SW_AGENT_COLLECTOR_BACKEND_SERVICES=your-cloud-host:11800

# Alipay
ALIPAY_APP_ID=your-app-id
ALIPAY_PRIVATE_KEY=your-private-key
ALIPAY_PUBLIC_KEY=your-public-key
ALIPAY_NOTIFY_URL=http://your-domain/api/v1/pay/callback/alipay
ALIPAY_RETURN_URL=http://your-domain/pay/success