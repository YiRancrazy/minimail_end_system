<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <module name="TreeWalker">
    <module name="Indentation"><property name="basicOffset" value="4"/></module>
    <module name="LeftCurly"><property name="option" value="nl"/></module>
    <module name="RightCurly"><property name="option" value="alone"/></module>
    <module name="ImportOrder">
      <property name="groups" value="java,javax,org,com,*,/^com\.yirancrazy\./"/>
      <property name="sortStaticImportsAlphabetically" value="true"/>
    </module>
    <module name="PackageName"><property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/></module>
  </module>
  <module name="FileTabCharacter"/>
  <module name="LineLength"><property name="max" value="120"/></module>
</module>